<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Retro Football Manager</title>
  <style>
    :root { --navy:#14213d; --green:#2a9d65; --paper:#f5f0df; --ink:#19221d; }
    * { box-sizing: border-box; }
    body { margin:0; background:var(--paper); color:var(--ink); font:16px system-ui, sans-serif; }
    header { background:var(--navy); color:white; padding:24px; text-align:center; }
    header h1 { margin:0 0 5px; }
    main { max-width:1000px; margin:24px auto; padding:0 16px 40px; }
    section { background:white; border:2px solid var(--navy); border-radius:12px; padding:18px; margin:16px 0; }
    h2 { margin-top:0; color:var(--navy); }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:12px; }
    label { display:block; font-weight:650; margin-bottom:5px; }
    input, select, button { width:100%; padding:10px; border-radius:7px; border:1px solid #999; font:inherit; }
    button { background:var(--green); color:white; border:0; font-weight:700; cursor:pointer; margin-top:12px; }
    button:hover { filter:brightness(.92); }
    button.secondary { background:var(--navy); }
    button.danger { background:#b33a3a; width:auto; padding:6px 10px; margin:0; }
    .stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(130px,1fr)); gap:10px; }
    .stat { background:#edf5ee; padding:12px; border-radius:8px; text-align:center; }
    .stat strong { display:block; font-size:1.5rem; color:var(--navy); }
    .table-wrap { overflow-x:auto; }
    table { width:100%; border-collapse:collapse; margin-top:10px; }
    th,td { padding:9px; text-align:left; border-bottom:1px solid #ddd; }
    th { color:var(--navy); }
    .muted { color:#58615b; font-size:.92rem; }
    .message { min-height:1.3em; color:var(--green); font-weight:650; }
  </style>
</head>
<body>
  <header>
    <h1>Retro Football Manager</h1>
    <div>Fan-made roster, stats, and season tracker</div>
  </header>

  <main>
    <section>
      <h2>Team dashboard</h2>
      <div class="stats" id="dashboard"></div>
    </section>

    <section>
      <h2>Roster manager</h2>
      <form id="playerForm">
        <div class="grid">
          <div><label for="playerName">Player name</label><input id="playerName" required maxlength="30"></div>
          <div><label for="position">Position</label>
            <select id="position">
              <option>QB</option><option>RB</option><option>WR</option>
              <option>TE</option><option>OL</option><option>DL</option>
              <option>LB</option><option>DB</option><option>K</option>
            </select>
          </div>
          <div><label for="age">Age</label><input id="age" type="number" min="18" max="50" value="22"></div>
          <div><label for="rating">Rating (1–5 stars)</label><input id="rating" type="number" min="1" max="5" value="3"></div>
        </div>
        <button type="submit">Add player</button>
      </form>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Name</th><th>Position</th><th>Age</th><th>Rating</th><th></th></tr></thead>
          <tbody id="roster"></tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>Record a game</h2>
      <form id="gameForm">
        <div class="grid">
          <div><label for="opponent">Opponent</label><input id="opponent" required maxlength="40"></div>
          <div><label for="pointsFor">Your points</label><input id="pointsFor" type="number" min="0" value="0" required></div>
          <div><label for="pointsAgainst">Opponent points</label><input id="pointsAgainst" type="number" min="0" value="0" required></div>
          <div><label for="passingYards">Passing yards</label><input id="passingYards" type="number" min="0" value="0"></div>
          <div><label for="rushingYards">Rushing yards</label><input id="rushingYards" type="number" min="0" value="0"></div>
          <div><label for="touchdowns">Touchdowns</label><input id="touchdowns" type="number" min="0" value="0"></div>
        </div>
        <button type="submit">Save game</button>
      </form>
      <p class="message" id="message"></p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Opponent</th><th>Score</th><th>Result</th><th>Pass Yds</th><th>Rush Yds</th><th>TDs</th></tr></thead>
          <tbody id="games"></tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>Season simulator</h2>
      <p class="muted">Simulates a 17-game season using your roster rating. It adds simulated results to your game history.</p>
      <button class="secondary" id="simulateButton">Simulate 17-game season</button>
      <button class="danger" id="resetButton" style="margin-top:12px">Reset all saved data</button>
    </section>
  </main>

  <script>
    const STORAGE_KEY = "retroFootballManagerData";
    const blankData = () => ({ roster: [], games: [] });

    function loadData() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY)) || blankData();
      } catch {
        return blankData();
      }
    }

    let data = loadData();

    function saveData() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      render();
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>"']/g, char => ({
        "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;"
      })[char]);
    }

    function render() {
      const wins = data.games.filter(g => g.pointsFor > g.pointsAgainst).length;
      const losses = data.games.filter(g => g.pointsFor < g.pointsAgainst).length;
      const ties = data.games.length - wins - losses;
      const pointsFor = data.games.reduce((sum, g) => sum + g.pointsFor, 0);
      const pointsAgainst = data.games.reduce((sum, g) => sum + g.pointsAgainst, 0);

      document.getElementById("dashboard").innerHTML = `
        <div class="stat"><strong>${data.roster.length}</strong>Players</div>
        <div class="stat"><strong>${wins}–${losses}${ties ? "–" + ties : ""}</strong>Record</div>
        <div class="stat"><strong>${pointsFor}</strong>Points scored</div>
        <div class="stat"><strong>${pointsAgainst}</strong>Points allowed</div>`;

      document.getElementById("roster").innerHTML = data.roster.length
        ? data.roster.map((p, i) => `<tr>
            <td>${escapeHtml(p.name)}</td><td>${escapeHtml(p.position)}</td>
            <td>${p.age}</td><td>${"★".repeat(p.rating)}${"☆".repeat(5-p.rating)}</td>
            <td><button class="danger" onclick="removePlayer(${i})">Remove</button></td>
          </tr>`).join("")
        : `<tr><td colspan="5" class="muted">No players yet—add someone above.</td></tr>`;

      document.getElementById("games").innerHTML = data.games.length
        ? [...data.games].reverse().map(g => `<tr>
            <td>${escapeHtml(g.opponent)}</td>
            <td>${g.pointsFor}–${g.pointsAgainst}</td>
            <td>${g.pointsFor > g.pointsAgainst ? "Win" : g.pointsFor < g.pointsAgainst ? "Loss" : "Tie"}</td>
            <td>${g.passingYards}</td><td>${g.rushingYards}</td><td>${g.touchdowns}</td>
          </tr>`).join("")
        : `<tr><td colspan="6" class="muted">No games recorded yet.</td></tr>`;
    }

    function removePlayer(index) {
      data.roster.splice(index, 1);
      saveData();
    }

    document.getElementById("playerForm").addEventListener("submit", event => {
      event.preventDefault();
      data.roster.push({
        name: document.getElementById("playerName").value.trim(),
        position: document.getElementById("position").value,
        age: Number(document.getElementById("age").value),
        rating: Number(document.getElementById("rating").value)
      });
      event.target.reset();
      saveData();
    });

    document.getElementById("gameForm").addEventListener("submit", event => {
      event.preventDefault();
      const get = id => Number(document.getElementById(id).value);
      data.games.push({
        opponent: document.getElementById("opponent").value.trim(),
        pointsFor: get("pointsFor"),
        pointsAgainst: get("pointsAgainst"),
        passingYards: get("passingYards"),
        rushingYards: get("rushingYards"),
        touchdowns: get("touchdowns")
      });
      event.target.reset();
      document.getElementById("message").textContent = "Game saved!";
      saveData();
    });

    document.getElementById("simulateButton").addEventListener("click", () => {
      const averageRating = data.roster.length
        ? data.roster.reduce((sum, p) => sum + p.rating, 0) / data.roster.length
        : 3;
      const winChance = Math.min(.85, Math.max(.2, .35 + averageRating * .09));
      for (let week = 1; week <= 17; week++) {
        const won = Math.random() < winChance;
        const pointsFor = won ? 21 + Math.floor(Math.random() * 21) : 7 + Math.floor(Math.random() * 21);
        const pointsAgainst = won ? Math.floor(Math.random() * pointsFor) : pointsFor + 1 + Math.floor(Math.random() * 14);
        data.games.push({
          opponent: `Simulated opponent ${week}`,
          pointsFor, pointsAgainst,
          passingYards: 150 + Math.floor(Math.random() * 220),
          rushingYards: 40 + Math.floor(Math.random() * 140),
          touchdowns: 1 + Math.floor(Math.random() * 4)
        });
      }
      document.getElementById("message").textContent = "Season simulated and added to your game history.";
      saveData();
    });

    document.getElementById("resetButton").addEventListener("click", () => {
      if (confirm("Delete all roster and game data saved in this browser?")) {
        data = blankData();
        saveData();
        document.getElementById("message").textContent = "Saved data reset.";
      }
    });

    render();
  </script>
</body>
</html>
